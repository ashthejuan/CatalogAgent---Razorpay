RAZORPAY_KEY_ID=      # test-mode key from dashboard
RAZORPAY_KEY_SECRET=  # test-mode secret — NEVER commit the real .env
LLM_API_KEY=          # OpenAI-compatible endpoint key
LLM_BASE_URL=         # e.g. https://api.provider.com/v1
LLM_MODEL=            # e.g. gpt-4o-mini (provider-specific model id)
KEY_PEPPER=           # optional HMAC pepper for buyer-key hashing
